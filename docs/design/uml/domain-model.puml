' ---------- Market data and structure ----------

enum Timeframe {
  M1
  M5
  H1
  H4
}

class Candle {
  - _pair : CurrencyPair
  - _timeframe : Timeframe
  - _time : datetime
  - _open : float
  - _high : float
  - _low : float
  - _close : float
  - _volume : int
  + __init__(pair : CurrencyPair, timeframe : Timeframe, time : datetime, open_ : float, high : float, low : float, close : float, volume : int, complete : bool)
  .. read-only properties ..
  + pair : CurrencyPair
  + timeframe : Timeframe
  + time : datetime
  + open : float
  + high : float
  + low : float
  + close : float
  + volume : int
}

class SwingPoint {
  - _pair : CurrencyPair
  - _timeframe : Timeframe
  - _time : datetime
  - _price : float
  - _label : str
  + __init__(pair : CurrencyPair, timeframe : Timeframe, time : datetime, price : float, label : str)
  .. read-only properties ..
  + pair : CurrencyPair
  + timeframe : Timeframe
  + time : datetime
  + price : float
  + label : str
  + kind : str
}

abstract class StructureEvent {
  - _swing : SwingPoint
  - _time : datetime
  - _close : float
  - _direction : str
  + __init__(swing : SwingPoint, time : datetime, close : float)
  # {abstract} _direction_for(label : str) : str
  .. read-only properties ..
  + swing : SwingPoint
  + time : datetime
  + close : float
  + direction : str
}

note right of StructureEvent
  Abstract base class (ABC): a bare StructureEvent
  cannot be created (TypeError).
  __init__ sets direction from _direction_for(swing.label).
end note

class BreakOfStructure {
  + __init__(swing : SwingPoint, time : datetime, close : float)
  # _direction_for(label : str) : str
}

class ChangeOfCharacter {
  + __init__(swing : SwingPoint, time : datetime, close : float)
  # _direction_for(label : str) : str
}

StructureEvent <|-- BreakOfStructure
StructureEvent <|-- ChangeOfCharacter

class TimeframeAnalysis {
  - _pair : CurrencyPair
  - _timeframe : Timeframe
  - _trend : str
  - _latest_event : StructureEvent | None
  + __init__(pair : CurrencyPair, timeframe : Timeframe, trend : str, latest_event : StructureEvent | None = None)
  .. read-only properties ..
  + pair : CurrencyPair
  + timeframe : Timeframe
  + trend : str
  + latest_event : StructureEvent | None
  .. methods ..
  + vote() : str
}

class Signal {
  - _m1 : TimeframeAnalysis
  - _m5 : TimeframeAnalysis
  - _h1 : TimeframeAnalysis
  - _h4 : TimeframeAnalysis
  - _min_score : int
  + __init__(m1 : TimeframeAnalysis, m5 : TimeframeAnalysis, h1 : TimeframeAnalysis, h4 : TimeframeAnalysis, min_score : int = 3)
  .. read-only properties ..
  + m1 : TimeframeAnalysis
  + m5 : TimeframeAnalysis
  + h1 : TimeframeAnalysis
  + h4 : TimeframeAnalysis
  + pair : CurrencyPair
  + min_score : int
  .. methods ..
  - _count(vote : str) : int
  + direction() : str | None
  + score() : int
  + is_valid() : bool
  + trade_direction() : TradeDirection | None
  + reference_timeframe() : Timeframe | None
}

note right of Signal
  trade_direction() is a factory method (Phase 08): it creates a
  BuyDirection when bullish or a SellDirection when bearish, so callers
  get a TradeDirection without choosing the concrete type.
end note

' ---------- Plans, orders, trades, and the account ----------

class Account {
  - _account_id : str
  - _balance : float
  - _currency : str
  - _environment : str
  - _risk_percent : float
  - _trades : list[Trade]
  + __init__(account_id : str, balance : float, currency : str, environment : str, risk_percent : float)
  .. read-only properties ..
  + account_id : str
  + balance : float
  + currency : str
  + environment : str
  + risk_percent : float
  + trades : tuple[Trade, ...]
  .. methods ..
  + max_risk_amount() : float
  - _holds(trade : Trade) : bool
  - _check_new_trade(trade : Trade, replacing : Trade | None = None)
  + add_trade(trade : Trade)
  + remove_trade(trade : Trade)
  + close_trade(open_trade : Trade, closed_trade : Trade)
  + open_trades() : tuple[Trade, ...]
  + closed_trades() : tuple[Trade, ...]
}

class TradePlan {
  - _signal : Signal
  - _account : Account
  - _setup : TradeSetup
  - _take_profit_2 : float
  - _lot_size : float
  - _risk_amount : float
  + __init__(signal : Signal, account : Account, entry : float, stop_loss : float, take_profit_1 : float, take_profit_2 : float, lot_size : float)
  .. read-only properties ..
  + signal : Signal
  + account : Account
  + setup : TradeSetup
  + take_profit_2 : float
  + lot_size : float
  + stop_loss_pips : float
  + risk_amount : float
  + reference_timeframe : Timeframe | None
}

note right of TradePlan
  Creates its own TradeSetup with signal.trade_direction(),
  signal.pair, entry, stop_loss, and take_profit_1 (composition).
  risk_amount = lot_size × stop_loss_pips × pair.pip_value_per_lot(entry),
  rounded to cents, computed in __init__. reference_timeframe comes from the signal.
end note

class TradePlanBuilder {
  - _parts : dict[str, object]
  + __init__()
  .. methods (each returns the builder) ..
  + signal(signal : Signal) : TradePlanBuilder
  + account(account : Account) : TradePlanBuilder
  + entry(entry : float) : TradePlanBuilder
  + stop_loss(stop_loss : float) : TradePlanBuilder
  + take_profit_1(take_profit_1 : float) : TradePlanBuilder
  + take_profit_2(take_profit_2 : float) : TradePlanBuilder
  + lot_size(lot_size : float) : TradePlanBuilder
  + build() : TradePlan
}

note right of TradePlanBuilder
  Builder (Phase 08). build() raises ValueError naming any part
  that was never given, then returns TradePlan(**parts);
  TradePlan's constructor does all the validation.
end note

class Order {
